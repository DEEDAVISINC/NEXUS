# NEXUS frontend — copy to .env.local for local `npm start`

# General API (orders, GPSS, etc.) — omit to use http://127.0.0.1:8000
# REACT_APP_API_BASE=https://deedavis.pythonanywhere.com

# Voice Intake / Twilio / ElevenLabs — defaults to PythonAnywhere when general API is local
# Override only to test voice against a local api_server with keys loaded
# REACT_APP_VOICE_API_BASE=https://deedavis.pythonanywhere.com
