# Airtable Configuration
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_base_id_here

# Claude AI Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Search API (for opportunity mining)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here

# Flask Configuration
PORT=8000

# --- PRISM transport (NEMT / rides) — never commit real secrets ---
# Uber Health Rides API (see PRISM_UBER_HEALTH_RIDES.md)
UBER_HEALTH_ORG_ID=
UBER_HEALTH_CLIENT_ID=
UBER_HEALTH_CLIENT_SECRET=
# Optional: UBER_HEALTH_TOKEN_URL=https://login.uber.com/oauth/v2/token

# Lyft (future integration; prism_transport_env.py)
LYFT_ORG_ID=
LYFT_CLIENT_ID=
LYFT_CLIENT_SECRET=

# SHIELD (lead screening base) — optional: comma-separated emails that always get
# full supervisor API/UI powers (Ultimate Supervisor), even if Navigators.role is wrong.
# SHIELD_ULTIMATE_SUPERVISOR_EMAILS=you@company.biz
